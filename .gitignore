# DS Methodologies Portfolio - Git Ignore

# ===== Data Files =====
# Exclude large datasets (download separately from Kaggle)
**/data/raw/*.csv
**/data/raw/*.zip
**/data/processed/
**/data/*.csv
**/data/*.parquet
**/data/*.feather

# ===== Model Artifacts =====
# Exclude trained models (generated by notebooks)
**/app/artifacts/*.joblib
**/app/artifacts/*.pkl
**/app/artifacts/*.h5
**/app/artifacts/*.pt
**/app/artifacts/*.pth

# Keep the artifacts directory structure but not the files
!**/app/artifacts/.gitkeep

# ===== Python =====
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv

# ===== Jupyter Notebook =====
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Jupyter Notebook temporary files
.jupyter/
.local/

# ===== IDEs =====
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# ===== MacOS =====
.DS_Store
.AppleDouble
.LSOverride
._*

# ===== Windows =====
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ===== Logs =====
*.log
logs/
*.out

# ===== Environment Variables =====
.env
.env.local
.env.*.local
*.env

# ===== Testing =====
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ===== Docker =====
*.pid
*.seed
*.pid.lock

# ===== Temporary Files =====
*.tmp
*.temp
*.swp
*.swo
*~
.cache/

# ===== ML Specific =====
# TensorBoard logs
runs/
tensorboard/

# MLflow
mlruns/
mlartifacts/

# Weights & Biases
wandb/

# ===== Assets =====
# Keep asset directories but exclude large images (optional)
# Uncomment if you have very large visualization files
# **/assets/*.png
# **/assets/*.jpg
# **/assets/*.jpeg

# ===== Documentation =====
# Keep all markdown files
!*.md
!README*.md

# ===== Keep Important Config Files =====
!requirements.txt
!Dockerfile
!.dockerignore
!docker-compose.yml

# ===== Kaggle =====
kaggle.json
.kaggle/

# ===== Private Files =====
**/VIDEO_TALK_TRACK.md
test_api_key.py
